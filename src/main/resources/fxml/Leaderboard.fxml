<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<StackPane fx:id="rootPane" styleClass="root-pane"
           stylesheets="@../css/board.css, @../css/lobby.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am54.gui.LeaderboardController">

    <Region style="-fx-background-color: black;" />

    <AnchorPane fx:id="mainArea" prefWidth="1920" prefHeight="1080"
                minWidth="1920" minHeight="1080" maxWidth="1920" maxHeight="1080"
                style="-fx-font-family: 'Herculanum';"> <ImageView fitWidth="1920" fitHeight="1080" preserveRatio="true">
        <image>
            <Image url="@../images/sfondo_classifica.png" />
        </image>
    </ImageView>

        <VBox layoutX="0" layoutY="50" prefWidth="1920" alignment="TOP_CENTER" mouseTransparent="true">
            <Label text="CLASSIFICA FINALE!" styleClass="lobby-title" textFill="WHITE"/>
        </VBox>

        <VBox fx:id="podium2" alignment="BOTTOM_CENTER" spacing="5"
              layoutX="635" layoutY="183" prefWidth="200" prefHeight="200" visible="false" pickOnBounds="false">
            <Label fx:id="name2" text="NAME" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-effect: dropshadow(three-pass-box, black, 4, 0.8, 0, 2);"/>
            <ImageView fx:id="totem2" fitHeight="100" preserveRatio="true" />
        </VBox>

        <VBox fx:id="podium3" alignment="BOTTOM_CENTER" spacing="5"
              layoutX="824" layoutY="202" prefWidth="200" prefHeight="200" visible="false" pickOnBounds="false">
            <Label fx:id="name3" text="NAME" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-effect: dropshadow(three-pass-box, black, 4, 0.8, 0, 2);"/>
            <ImageView fx:id="totem3" fitHeight="90" preserveRatio="true" />
        </VBox>

        <VBox fx:id="podium1" alignment="BOTTOM_CENTER" spacing="5"
              layoutX="728" layoutY="141" prefWidth="200" prefHeight="200" visible="false" pickOnBounds="false">
            <Label fx:id="name1" text="NAME" textFill="GOLD" style="-fx-font-weight: bold; -fx-font-size: 26px; -fx-effect: dropshadow(three-pass-box, black, 6, 0.8, 0, 2);"/>
            <ImageView fx:id="totem1" fitHeight="120" preserveRatio="true" />
        </VBox>

        <Label fx:id="playerPositionLabel" text="" textFill="GOLD" layoutX="360" layoutY="590"
               prefWidth="1200" alignment="CENTER" style="-fx-font-size: 20px; -fx-font-weight: bold;" visible="false" />

        <VBox alignment="TOP_CENTER" layoutX="360" layoutY="620" prefWidth="1200" spacing="10">
            <Label text="Classifica storica:" textFill="WHITE" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

            <VBox fx:id="rankingTable" spacing="5" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 15; -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-border-color: transparent transparent white transparent; -fx-padding: 0 0 10 0;">
                    <Label text="POS" prefWidth="60" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    <Label text="TOTEM" prefWidth="80" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    <Label text="NICKNAME" prefWidth="300" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    <Label text="✨ AURA" prefWidth="120" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    <Label text="🍖 CIBO" prefWidth="120" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    <Label text="🔮 MAGIA" prefWidth="120" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    <Label text="👥 TRIBÙ" prefWidth="120" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    <Label text="🏛️ EDIFICI" prefWidth="120" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                </HBox>
            </VBox>
        </VBox>

        <HBox alignment="CENTER" layoutX="0" layoutY="900" prefWidth="1920" pickOnBounds="false">
            <Button text="TORNA AL MENU" styleClass="recap-button" onAction="#handleReturnToMenu"/>
        </HBox>

    </AnchorPane>

</StackPane>