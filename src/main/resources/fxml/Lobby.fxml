<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane fx:id="mainContainer" minWidth="888.0" minHeight="600.0" prefWidth="1000.0" prefHeight="600.0" style="-fx-background-color: black;"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am54.gui.LobbyController">

    <children>
        <ImageView preserveRatio="false" fitWidth="${mainContainer.width}" fitHeight="${mainContainer.height}">
            <image><Image url="@../images/sfondo_lobby.jpg" /></image>
        </ImageView>

        <VBox alignment="TOP_CENTER" spacing="0">
            <children>
                <Region minHeight="20.0" prefHeight="120.0" maxHeight="120.0" VBox.vgrow="ALWAYS" />

                <VBox fx:id="nicknameContainer" alignment="CENTER" spacing="25.0">
                    <children>
                        <Label text="BENVENUTO"
                               style="-fx-font-family: 'Alice in Wonderland'; -fx-font-size: 100; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);" />

                        <TextField fx:id="nicknameField" onAction="#onJoinClicked" promptText="Scrivi il tuo nome e premi Invio..." maxWidth="350.0"
                                   style="-fx-font-size: 20; -fx-alignment: center; -fx-background-radius: 15; -fx-background-color: rgba(255, 255, 255, 0.9);" />

                        <Label fx:id="errorLabel" textFill="#ff5555" style="-fx-font-weight: bold; -fx-font-size: 16;" />
                    </children>
                </VBox>

                <VBox fx:id="lobbyContainer" alignment="TOP_CENTER" spacing="0" visible="false" managed="false">
                    <children>
                        <Label fx:id="statusLabel" text="Connessione in corso..."
                               style="-fx-font-size: 24; -fx-text-fill: white; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);">
                            <VBox.margin><Insets bottom="35.0" /></VBox.margin>
                        </Label>

                        <ListView fx:id="playersListView" minHeight="180.0" prefHeight="310.0" maxHeight="310.0" prefWidth="600.0" maxWidth="600.0"
                                  style="-fx-background-color: rgba(255, 255, 255, 0.8); -fx-background-radius: 10;" />

                        <Region minHeight="40.0" prefHeight="110.0" maxHeight="110.0" VBox.vgrow="ALWAYS" />

                        <HBox fx:id="colorSelectionBox" alignment="CENTER" spacing="60.0" maxWidth="600.0"
                              style="-fx-background-color: rgba(255, 255, 255, 0.23); -fx-background-radius: 20; -fx-padding: 15;">
                            <children>
                                <Button onAction="#onColorYellow" onMouseEntered="#onHoverEnter" onMouseExited="#onHoverExit" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                    <graphic><ImageView fitWidth="75.0" preserveRatio="true"><image><Image url="@../images/totem_yellow_3d_160x270.png" /></image></ImageView></graphic>
                                </Button>
                                <Button onAction="#onColorRed" onMouseEntered="#onHoverEnter" onMouseExited="#onHoverExit" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                    <graphic><ImageView fitWidth="75.0" preserveRatio="true"><image><Image url="@../images/totem_red_3d_160x270.png" /></image></ImageView></graphic>
                                </Button>
                                <Button onAction="#onColorBlack" onMouseEntered="#onHoverEnter" onMouseExited="#onHoverExit" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                    <graphic><ImageView fitWidth="75.0" preserveRatio="true"><image><Image url="@../images/totem_black_3d_160x270.png" /></image></ImageView></graphic>
                                </Button>
                                <Button onAction="#onColorBlue" onMouseEntered="#onHoverEnter" onMouseExited="#onHoverExit" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                    <graphic><ImageView fitWidth="75.0" preserveRatio="true"><image><Image url="@../images/totem_blue_3d_160x270.png" /></image></ImageView></graphic>
                                </Button>
                                <Button onAction="#onColorWhite" onMouseEntered="#onHoverEnter" onMouseExited="#onHoverExit" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                    <graphic><ImageView fitWidth="75.0" preserveRatio="true"><image><Image url="@../images/totem_white_3d_160x270.png" /></image></ImageView></graphic>
                                </Button>
                            </children>
                        </HBox>

                        <Region minHeight="15.0" prefHeight="30.0" maxHeight="30.0" VBox.vgrow="ALWAYS" />

                        <Button fx:id="startGameButton" onAction="#onStartGameClicked" onMouseEntered="#onHoverEnter" onMouseExited="#onHoverExit" text="START" visible="false"
                                style="-fx-font-family: 'Alice in Wonderland'; -fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 80; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 15, 0, 0, 0);" />
                    </children>
                </VBox>

                <Region minHeight="100.0" prefHeight="120.0" maxHeight="120.0" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </children>
</StackPane>