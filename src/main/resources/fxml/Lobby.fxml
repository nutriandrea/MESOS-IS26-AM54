<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="lobbyRoot" stylesheets="@../css/lobby.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am54.gui.LobbyController">

    <VBox alignment="TOP_CENTER" spacing="10" pickOnBounds="false">
        <padding><Insets top="50"/></padding>
        <HBox alignment="CENTER" pickOnBounds="false">
            <Region prefWidth="450" mouseTransparent="true" />

            <Label fx:id="welcomeLabel" text="BENVENUTO NELLA CAVERNA" styleClass="lobby-title" mouseTransparent="true"/>

            <HBox alignment="CENTER_LEFT" spacing="15" prefWidth="450" pickOnBounds="false">
                <padding><Insets left="180"/></padding>
                <Label text="Regole del gioco" styleClass="info-label" mouseTransparent="true"/>
                <Button fx:id="infoButton" text="i" styleClass="info-button" onAction="#handleOpenRules"/>
            </HBox>
        </HBox>
        <Label fx:id="subtitleLabel" text="SCEGLI IL TUO TOTEM!" styleClass="lobby-subtitle" mouseTransparent="true"/>
        <Button fx:id="startButton" text="START" styleClass="start-button" visible="false" managed="false" onAction="#handleStartGame">
            <VBox.margin><Insets top="30.0" /></VBox.margin>
        </Button>
    </VBox>

    <VBox fx:id="redBox" alignment="CENTER" pickOnBounds="false" maxWidth="200" maxHeight="250">
        <Label fx:id="nameRed" styleClass="totem-name-label" />
        <ImageView fx:id="totemRed" preserveRatio="true" styleClass="totem-button" onMouseClicked="#handleTotemSelection" />
    </VBox>

    <VBox fx:id="yellowBox" alignment="CENTER" pickOnBounds="false" maxWidth="200" maxHeight="250">
        <Label fx:id="nameYellow" styleClass="totem-name-label" />
        <ImageView fx:id="totemYellow" preserveRatio="true" styleClass="totem-button" onMouseClicked="#handleTotemSelection" />
    </VBox>

    <VBox fx:id="blueBox" alignment="CENTER" pickOnBounds="false" maxWidth="200" maxHeight="250">
        <Label fx:id="nameBlue" styleClass="totem-name-label" />
        <ImageView fx:id="totemBlue" preserveRatio="true" styleClass="totem-button, mirrored" onMouseClicked="#handleTotemSelection" />
    </VBox>

    <VBox fx:id="blackBox" alignment="CENTER" pickOnBounds="false" maxWidth="200" maxHeight="250">
        <Label fx:id="nameBlack" styleClass="totem-name-label" />
        <ImageView fx:id="totemBlack" preserveRatio="true" styleClass="totem-button, mirrored" onMouseClicked="#handleTotemSelection" />
    </VBox>

    <VBox fx:id="whiteBox" alignment="CENTER" pickOnBounds="false" maxWidth="200" maxHeight="250">
        <Label fx:id="nameWhite" styleClass="totem-name-label" />
        <ImageView fx:id="totemWhite" preserveRatio="true" styleClass="totem-button, mirrored" onMouseClicked="#handleTotemSelection" />
    </VBox>

    <StackPane fx:id="rulesOverlay" visible="false" managed="false" styleClass="rules-overlay" pickOnBounds="false">
        <VBox alignment="CENTER" spacing="2" styleClass="rules-book-container" maxHeight="715" maxWidth="1275">
            <HBox alignment="CENTER_RIGHT">
                <Button text="X" styleClass="close-button" onAction="#handleCloseRules"/>
            </HBox>
            <HBox alignment="CENTER" spacing="15">
                <ImageView fx:id="leftPageImage" fitWidth="620" fitHeight="645" preserveRatio="true"/>
                <ImageView fx:id="rightPageImage" fitWidth="620" fitHeight="645" preserveRatio="true"/>
            </HBox>
            <HBox alignment="CENTER" spacing="60">
                <VBox.margin><Insets top="2.0" bottom="2.0"/></VBox.margin>
                <Button fx:id="prevPageButton" text="&lt;" styleClass="nav-button" onAction="#handlePrevPage"/>
                <Label fx:id="pageLabel" text="1-2 / 8" styleClass="page-label"/>
                <Button fx:id="nextPageButton" text="&gt;" styleClass="nav-button" onAction="#handleNextPage"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>