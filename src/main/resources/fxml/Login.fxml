<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" onMouseClicked="#handleRootClick"
           stylesheets="@../css/login.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am54.gui.LoginController">

    <Button fx:id="leaderboardButton" text="🏆 CLASSIFICA" styleClass="leaderboard-login-button"
            StackPane.alignment="TOP_RIGHT" onAction="#handleLeaderboardButton">
        <StackPane.margin>
            <Insets top="30" right="40" />
        </StackPane.margin>
    </Button>

    <VBox fx:id="logoBox" alignment="CENTER" pickOnBounds="false">
        <ImageView fx:id="logoMesos" preserveRatio="true">
            <image><Image url="@../images/logo_mesos.png" /></image>
        </ImageView>
    </VBox>

    <VBox fx:id="playStateBox" alignment="CENTER" pickOnBounds="false">
        <Button fx:id="playButton" text="GIOCA" onAction="#handlePlayAction" styleClass="play-button" />
    </VBox>

    <VBox fx:id="nicknameStateBox" alignment="CENTER" spacing="25" visible="false" managed="false"
          maxWidth="520" maxHeight="300" styleClass="translucent-box">

        <Label text="UNISCITI ALLA TRIBÙ" styleClass="gold-text" style="-fx-font-size: 36px;" />

        <VBox alignment="CENTER" spacing="10">
            <Label text="INDIRIZZO IP SERVER" styleClass="gold-text" style="-fx-font-size: 14px;" />
            <TextField fx:id="serverIpField" text="localhost" styleClass="custom-input" maxWidth="380" />
        </VBox>

        <HBox alignment="CENTER" spacing="50">
            <RadioButton fx:id="socketRadio" text="SOCKET" selected="true" styleClass="custom-radio">
                <toggleGroup><ToggleGroup fx:id="protocolGroup"/></toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rmiRadio" text="RMI" toggleGroup="$protocolGroup" styleClass="custom-radio"/>
        </HBox>

        <VBox alignment="CENTER" spacing="10">
            <Label text="IL TUO NOME" styleClass="gold-text" style="-fx-font-size: 14px;" />
            <TextField fx:id="nicknameField" promptText="NICKNAME..." styleClass="custom-input" maxWidth="380"
                       onAction="#handleNicknameSubmit" />
        </VBox>

        <Button text="CONFERMA" onAction="#handleNicknameSubmit" styleClass="play-button" style="-fx-font-size: 22px;" />
        <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true" maxWidth="450" alignment="CENTER"/>
    </VBox>

    <Label fx:id="clickToEnterLabel"
           text="CLICCA OVUNQUE PER ENTRARE NELLA CAVERNA!"
           styleClass="cave-prompt"
           visible="false"
           managed="false"
           wrapText="true"
           maxWidth="800"
           StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets bottom="60"/>
        </StackPane.margin>
    </Label>

    <StackPane fx:id="leaderboardOverlay" visible="false" managed="false" styleClass="leaderboard-overlay-bg" onMouseClicked="#handleOverlayClose">
        <VBox styleClass="leaderboard-modal-panel" maxWidth="750" maxHeight="600" spacing="15" alignment="CENTER" onMouseClicked="#handlePanelClick">
            <Label text="🏆 CLASSIFICA GLOBALE 🏆" styleClass="leaderboard-modal-title" />

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="leaderboard-scroll-pane" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox fx:id="leaderboardEntriesContainer" spacing="8" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="10" bottom="10" left="10" right="10"/>
                    </padding>
                </VBox>
            </ScrollPane>

            <Label fx:id="leaderboardFooter" text="" styleClass="leaderboard-modal-footer" />
            <Button text="CHIUDI" styleClass="leaderboard-close-btn" onAction="#handleOverlayClose" />
        </VBox>
    </StackPane>

</StackPane>