@startuml
skinparam linetype ortho
skinparam maxmessagesize 300
skinparam packageStyle rectangle

' ============================================================
' MODEL - CORE
' ============================================================

package "model" {

    interface IGame {
        +joinGame(String) : void
        +chooseTotemColor(String, String) : void
        +placeTotem(String, int) : void
        +pickCard(String, String, int) : void
        +setupGame() : void
        +addObserver(IGameObserver) : void
        +removeObserver(IGameObserver) : void
    }

    interface IGameObserver {
        +onPlayerJoined(Game, Player) : void
        +onTotemColorChosen(Game, Player, TotemColors) : void
        +onTotemPlaced(Game, Player, int) : void
        +onCardPicked(Game, Player, String, int, int) : void
        +onTurnChanged(Game, Player) : void
        +onStateChanged(Game, GameState) : void
        +onEndGame(Game, List<Player>) : void
    }

    interface IDrawable {
        +reveal(Board, String) : void
    }

    interface IPurchasable {
        +canBePurchased(Player) : boolean
    }

    interface IEffect<T> {
        +apply(Player, Game, T) : void
        +isFarmerEffect() : boolean
        +isEndgameEffect() : boolean
    }

    enum TotemColors {
        RED, YELLOW, WHITE, BLACK, BLUE
    }

    enum JobType {
        HUNTER, SHAMAN, CONSTRUCTOR, FARMER, INVENTOR, ARTIST, NULL
    }

    enum Phases {
        STARTTURN, POSTPICK, POSTACTION, EVENT, ENDGAME
    }

    class Game implements IGame {
        -Board board
        -Deck<TribeCard> deckTribu
        -Deck<BuildingCard> deckBuildings
        -List<Player> players
        -Player currentPlayer
        -GameState currentState
        -List<IGameObserver> observers
        -int currentEra
        -int roundCount
        +joinGame(String) : void
        +chooseTotemColor(String, String) : void
        +placeTotem(String, int) : void
        +pickCard(String, String, int) : void
        +setupGame() : void
        +nextPlayer() : void
        +advanceEra() : void
        +advanceRound() : void
        +setState(GameState) : void
        +getCurrentState() : GameState
        +getPlayerByNickname(String) : Player
        +getPlayers() : List<Player>
        +getPlayersNumber() : int
        +getBoard() : Board
        +getCurrentEra() : int
        +getRoundCount() : int
        +getCurrentPlayer() : Player
        +setCurrentPlayer(Player) : void
        +getCurrentPicker() : Player
        +assignPickerToTurnOrder(Player) : TurnOrderSlot
        +isPickingComplete() : boolean
        +isTribeDeckEmpty() : boolean
        +isEraTransition() : boolean
        +refillUpperTribeRow() : void
        +refillUpperBuildings() : void
        +calculatePlayerScore(Player) : int
        +determineWinners() : List<Player>
        +applyEndGameBuildingEffects() : void
        +notifyEndGame(List<Player>) : void
        +addObserver(IGameObserver) : void
        +removeObserver(IGameObserver) : void
    }

    class Player {
        -String nickname
        -TotemColors totemColor
        -int food
        -int aura
        -int magicPoints
        -boolean extraPick
        -boolean hasPlacedTotem
        -ArrayList<CharacterCard> myTribe
        -ArrayList<BuildingCard> myBuildings
        -int myBuildingDiscount
        -int myFoodDiscount
        -int eventCostFood
        -int eventCostAura
        -OfferingTile currentTile
        +getNickname() : String
        +getTotemColors() : TotemColors
        +getFood() : int
        +getAuraPoints() : int
        +getMagicPoints() : int
        +getMyTribe() : ArrayList<CharacterCard>
        +getBuildings() : ArrayList<BuildingCard>
        +getCurrentTile() : OfferingTile
        +hasPlacedTotem() : boolean
        +getEventCostFood() : int
        +getEventCostAura() : int
        +getMyBuildingDiscount() : int
        +getMyFoodDiscount() : int
        +setNickname(String) : void
        +setTotemColor(TotemColors) : void
        +setHasPlacedTotem(boolean) : void
        +setExtraPick(boolean) : void
        +setCurrentTile(OfferingTile) : void
        +modifyFood(int) : void
        +modifyAuraPoints(int) : void
        +modifyMagicPoints(int) : void
        +modifyMyTribe(CharacterCard) : void
        +modifyMyBuildingDiscount(int) : void
        +modifyMyFoodDiscount(int) : void
        +resetEventAttributes() : void
    }

    class Board {
        -List<CharacterCard> characterUpperRow
        -List<CharacterCard> characterLowerRow
        -List<EventCard> eventUpperRow
        -List<EventCard> eventLowerRow
        -List<BuildingCard> buildingCardsUpperRow
        -List<BuildingCard> buildingCardsLowerRow
        -List<OfferingTile> offeringTrack
        -List<TurnOrderSlot> turnOrderTile
        +initializeLayout(int) : void
        +addCharacterCard(CharacterCard, String) : void
        +addEventCard(EventCard, String) : void
        +addBuildingCard(BuildingCard, String) : void
        +takeCharacterCard(String, int) : CharacterCard
        +takeBuildingCard(String, int) : BuildingCard
        +getCharacterRowSize(String) : int
        +getBuildingRowSize(String) : int
        +getEventRowSize(String) : int
        +addTotemToPosition(Player, OfferingTile) : void
        +setupInitialTurnOrder(List<Player>) : void
        +getTurnOrderTile() : List<TurnOrderSlot>
        +getOfferingTrack() : List<OfferingTile>
        +moveUpperToLower() : void
        +moveBuildings() : void
        +refillUpperRow(Game) : void
        +resolveAllEventsInOrder(Game) : void
        +resolveAllVisibleEvents(Game) : void
        +allTotemsPlaced(int) : boolean
        +getFirstPlayerFromOfferingTrack() : Player
        +discardLowerRowBuildings() : void
        +clearLowerRow() : void
    }

    abstract class Card {
        -int era
        -Player owner
        +getEra() : int
        +addOwner(Player) : void
        +pick(Player, Game) : void
    }

    abstract class TribeCard extends Card implements IDrawable {
        +reveal(Board, String) : void
    }

    class CharacterCard extends TribeCard {
        -int level
        -JobType type
        -int aura
        -Phases phase
        -List<IEffect<CharacterCard>> effects
        +getLevel() : int
        +getJobType() : JobType
        +getAura() : int
        +getCost() : int
        +getName() : String
        +getEffects() : List<IEffect>
        +resolveEffects(Player, Game) : void
        +reveal(Board, String) : void
        +pick(Player, Game) : void
    }

    class EventCard extends TribeCard {
        -boolean finalEvent
        -List<IEffect<EventCard>> effects
        -int baseFood
        -int auraPerCharacter
        -int threshold
        -int bonusMultiplier
        -int penalty
        -int bonus
        -int malus
        +isFinalEvent() : boolean
        +isFarmerEvent() : boolean
        +shouldResolveLast() : boolean
        +resolveEvent(Game) : void
        +reveal(Board, String) : void
    }

    class BuildingCard extends Card implements IPurchasable {
        -String name
        -int cost
        -int finalAura
        -Phases phase
        -List<IEffect<BuildingCard>> effects
        -JobType buildingType
        +getName() : String
        +getCost() : int
        +getFinalAura() : int
        +getBuildingType() : JobType
        +getEffects() : List<IEffect>
        +canBePurchased(Player) : boolean
        +resolveEffects(Player, Game) : void
    }

    abstract class GameState {
        +joinGame(Game, String) : void
        +chooseTotemColor(Game, String, String) : void
        +setupGame(Game) : void
        +placeTotem(Game, String, int) : void
        +pickCard(Game, String, String, int) : void
        +endTurn(Game, String) : void
        +resolvePhase(Game) : void
    }

    class SetUpGameState extends GameState
    class StartTurnState extends GameState
    class PickingState extends GameState
    class EventState extends GameState
    class EndGameState extends GameState

    class Deck<T> {
        -Stack<T> cards
        +drawCard() : T
        +peek() : T
        +isEmpty() : boolean
        +size() : int
    }

    class DeckFactory {
        +createBuildingDeck(String, int) : Deck<BuildingCard>
        +createTribeDeck(String, String, int) : Deck<TribeCard>
        +createBuildingEffect(String, String, JsonNode) : IEffect
    }

    class OfferingTile {
        -char id
        -int cardsFromUpper
        -int cardsFromLower
        -int foodBonus
        -Player occupiedBy
        -int remainingUpperPicks
        -int remainingLowerPicks
        +getId() : char
        +getFoodBonus() : int
        +getOccupiedBy() : Player
        +isAvailable() : boolean
        +occupy(Player) : void
        +freeSlot() : void
        +useUpperPick() : void
        +useLowerPick() : void
        +hasPicksLeft() : boolean
    }

    class TurnOrderSlot {
        -int position
        -int bonusFood
        -Player occupiedBy
        +getPosition() : int
        +getBonusFood() : int
        +getOccupiedBy() : Player
        +occupy(Player) : void
        +freeSlot() : void
    }
}

' MODEL RELATIONSHIPS
IGame <|.. Game
IGameObserver <|.. VirtualView
IDrawable <|.. TribeCard
IPurchasable <|.. BuildingCard

Game --> Board
Game --> Player
Game --> GameState
Game --> Deck
Game --> DeckFactory

Player --> TotemColors
Player --> CharacterCard
Player --> BuildingCard
Player --> OfferingTile

Card <|-- TribeCard
Card <|-- BuildingCard
TribeCard <|-- CharacterCard
TribeCard <|-- EventCard

GameState <|-- SetUpGameState
GameState <|-- StartTurnState
GameState <|-- PickingState
GameState <|-- EventState
GameState <|-- EndGameState

CharacterCard --> JobType

' ============================================================
' NETWORK SERVER
' ============================================================

package "network.server" {

    class Server {
        -Game game
        -Controller controller
        -PersistenceManager persistenceManager
        -boolean isRunning
        +start(int, int) : void
        +startTCP(int) : void
        +startRMI(int) : void
        +getController() : Controller
        +getPersistenceManager() : PersistenceManager
    }

    note bottom of Server: Single game architecture\n(no multi-partita support)\n+ persistence (game_state.json)\n+ crash recovery

    class PersistenceManager {
        -ObjectMapper objectMapper
        -File saveFile
        -ScheduledExecutorService scheduler
        +saveState() : boolean
        +loadState() : GameFullSnapshot
        +hasSavedGame() : boolean
        +startPeriodicSave() : void
        +stopPeriodicSave() : void
    }

    class GameFullSnapshot {
        -int currentEra
        -int roundCount
        -String currentPlayerNickname
        -String currentStateName
        -int playerCount
        -List<CardInfo> deckTribuCards
        -List<CardInfo> deckBuildingsCards
        -BoardSnapshot boardSnapshot
        -List<PlayerSnapshot> players
    }

    class PlayerSnapshot {
        -String nickname
        -String totemColor
        -int food
        -int aura
        -int magicPoints
        -boolean extraPick
        -boolean hasPlacedTotem
        -int eventCostFood
        -int eventCostAura
        -int buildingDiscount
        -int foodDiscount
        -Character currentTileId
        -List<CardInfo> myTribe
        -List<CardInfo> myBuildings
    }

    class BoardSnapshot {
        -List<CardInfo> characterUpperRow
        -List<CardInfo> characterLowerRow
        -List<CardInfo> eventUpperRow
        -List<CardInfo> eventLowerRow
        -List<CardInfo> buildingUpperRow
        -List<CardInfo> buildingLowerRow
        -List<OfferingTileInfo> offeringTrack
        -List<TurnOrderSlotInfo> turnOrderTile
    }

    class CardInfo {
        -String name
        -String type
        -int cost
    }

    class OfferingTileInfo {
        -char id
        -int cardsFromUpper
        -int cardsFromLower
        -int foodBonus
    }

    class TurnOrderSlotInfo {
        -char id
        -String occupiedByNickname
        -boolean occupied
    }

    class SocketClientHandler implements Runnable, ClientConnection {
        -Socket socket
        -Server server
        -ObjectInputStream in
        -ObjectOutputStream out
        -String playerNickname
        -boolean connected
        -long lastPongTime
        -ScheduledExecutorService pingScheduler
        +run() : void
        +handleRequest(Request) : void
        +startPingScheduler() : void
        +sendUpdate(Update) : void
        +sendError(String) : void
        +disconnect() : void
    }

    class RMIServerImpl extends UnicastRemoteObject implements RMIGameServer {
        -Server server
        +connect(RMIClientInterface) : RMIClientHandlerInterface
    }

    class RMIClientHandler extends UnicastRemoteObject implements RMIClientHandlerInterface, ClientConnection {
        -RMIClientInterface clientStub
        -Server server
        -String playerNickname
        -boolean connected
        -long lastPongTime
        +handleRequest(Request) : void
        +startPingScheduler() : void
        +sendUpdate(Update) : void
        +sendError(String) : void
        +disconnect() : void
    }

    class VirtualView implements IGameObserver, ClientConnection {
        -ClientConnection connection
        -String nickname
        +getNickname() : String
        +sendUpdate(Update) : void
        +sendError(String) : void
        +disconnect() : void
        +onPlayerJoined(Game, Player) : void
        +onTotemColorChosen(Game, Player, TotemColors) : void
        +onTotemPlaced(Game, Player, int) : void
        +onCardPicked(Game, Player, String, int, int) : void
        +onTurnChanged(Game, Player) : void
        +onStateChanged(Game, GameState) : void
        +onEndGame(Game, List<Player>) : void
    }

    interface ClientConnection {
        +sendUpdate(Update) : void
        +sendError(String) : void
        +disconnect() : void
        +startHeartbeat() : void
    }

    class Controller {
        -Game game
        -Map<String, VirtualView> virtualViews
        -Set<String> disconnectedPlayers
        +Controller(Game)
        +handleJoinGame(String, ClientConnection) : void
        +handleReconnect(String, ClientConnection) : void
        +handleSetupGame(String) : void
        +handleChooseTotemColor(String, String) : void
        +handlePlaceTotem(String, int) : void
        +handlePickCard(String, String, int) : void
        +markDisconnected(String) : void
        +removeClient(String) : void
        +isDisconnected(String) : boolean
        +getPlayerCount() : int
    }
}

' SERVER RELATIONSHIPS
Server --> Game
Server --> Controller
Server --> PersistenceManager
Server --> SocketClientHandler
Server --> RMIServerImpl

PersistenceManager --> GameFullSnapshot
GameFullSnapshot --> PlayerSnapshot
GameFullSnapshot --> BoardSnapshot
GameFullSnapshot --> CardInfo

SocketClientHandler --> Server
SocketClientHandler --> ClientConnection
SocketClientHandler --> VirtualView

RMIServerImpl --> Server
RMIServerImpl --> RMIClientHandler

RMIClientHandler --> Server
RMIClientHandler --> RMIClientInterface

VirtualView --> IGameObserver
VirtualView --> ClientConnection

ClientConnection <|.. SocketClientHandler
ClientConnection <|.. RMIClientHandler
ClientConnection <|.. VirtualView

Controller --> Game
Controller --> VirtualView

' ============================================================
' NETWORK CLIENT
' ============================================================

package "network.client" {

    class Client {
        -ClientModel clientModel
        -ServerConnection connection
        +connect(String, boolean) : void
        +sendRequest(Request) : void
        +disconnect() : void
    }

    class ClientModel {
        -String currentState
        -String currentPlayer
        -List<String> players
        -Map<String, TotemColors> playerColors
        -Map<String, Integer> playerFood
        -Map<String, Integer> playerAura
        -Map<String, List<String>> playerTribe
        -Map<String, List<String>> playerBuildings
        -Map<Integer, String> offeringTrack
        -List<String> turnOrderTrack
        -List<String> characterUpperRow
        -List<String> characterLowerRow
        -List<String> eventUpperRow
        -List<String> eventLowerRow
        -List<String> upperBuildingRow
        -List<String> lowerBuildingRow
        -List<String> winners
        -String lastErrorMessage
        +loadFullState(GameStateUpdate) : void
        +updatePlayerJoined(String) : void
        +updatePlayerDisconnected(String) : void
        +updatePlayerReconnected(String) : void
        +updateTotemPlacement(String, int) : void
        +updateCardPicked(String, String, int, int) : void
        +updateTurn(String) : void
        +updateState(String) : void
        +updateTotemColor(String, TotemColors) : void
        +updateEndGame(List<String>) : void
        +updateError(String) : void
        +getCurrentState() : String
        +getCurrentPlayer() : String
        +getPlayers() : List<String>
        +getPlayerColors() : Map
    }

    class ServerHandler implements Runnable {
        -ObjectInputStream in
        -ObjectOutputStream out
        -ClientModel clientModel
        -volatile boolean running
        +run() : void
        +handlePing(PingRequest) : void
        +handleUpdate(Update) : void
        +stop() : void
    }

    class SocketServerConnection extends ServerConnection {
        -Socket socket
        -ObjectInputStream in
        -ObjectOutputStream out
        +connect(String, int) : void
        +sendRequest(Request) : void
        +receiveUpdate() : Object
    }

    class RMIServerConnection extends UnicastRemoteObject implements ServerConnection, RMIClientInterface {
        -RMIGameServer server
        -ClientModel clientModel
        +connect(RMIGameServer, ClientModel) : void
        +receiveUpdate(Update) : void
    }

    abstract class ServerConnection {
        +connect(String, int) : void
        +sendRequest(Request) : void
        +close() : void
    }
}

' CLIENT RELATIONSHIPS
Client --> ClientModel
Client --> ServerConnection

ServerConnection <|-- SocketServerConnection
ServerConnection <|-- RMIServerConnection

ServerHandler --> ClientModel
ServerHandler --> Request

' ============================================================
' NETWORK RMI
' ============================================================

package "network.rmi" {

    interface RMIGameServer extends Remote {
        +connect(RMIClientInterface) : RMIClientHandlerInterface
    }

    interface RMIClientInterface extends Remote {
        +receiveUpdate(Update) : void
    }

    interface RMIClientHandlerInterface extends Remote {
        +handleRequest(Request) : void
    }
}

' RMI RELATIONSHIPS
RMIGameServer <|.. RMIServerImpl
RMIClientInterface <|.. RMIServerConnection
RMIClientHandlerInterface <|.. RMIClientHandler

' ============================================================
' NETWORK MESSAGES
' ============================================================

package "network.messages" {

    interface Request extends ClientMessage
    interface Update extends ClientMessage
    interface ClientMessage

    class JoinGameRequest implements Request {
        -String nickname
        -String gameId
        +getNickname() : String
        +getGameId() : String
    }

    class SetupGameRequest implements Request
    class ChooseTotemRequest implements Request {
        -String color
        +getColor() : String
    }
    class PlaceTotemRequest implements Request {
        -int offerPosition
        +getOfferPosition() : int
    }
    class PickCardRequest implements Request {
        -String row
        -int cardIndex
        +getRow() : String
        +getCardIndex() : int
    }
    class ListGamesRequest implements Request
    class CreateGameRequest implements Request
    class PongResponse implements Request {
        -long timestamp
        +getTimestamp() : long
    }

    class PlayerJoinedUpdate implements Update {
        -String nickname
        +getNickname() : String
    }
    class PlayerDisconnectedUpdate implements Update {
        -String nickname
    }
    class PlayerReconnectedUpdate implements Update {
        -String nickname
    }
    class TotemColorUpdate implements Update {
        -String nickname
        -TotemColors color
    }
    class TotemPlacedUpdate implements Update {
        -String nickname
        -int offerPosition
    }
    class CardPickedUpdate implements Update {
        -String nickname
        -String row
        -int cardIndex
        -int newFoodBalance
    }
    class TurnChangedUpdate implements Update {
        -String nickname
    }
    class StateChangedUpdate implements Update {
        -String stateName
    }
    class EndGameUpdate implements Update {
        -List<String> winners
    }
    class ErrorMessageUpdate implements Update {
        -String message
    }
    class PingRequest implements Update {
        -long timestamp
        +getTimestamp() : long
    }

    class GameListUpdate implements Update {
        -List<String> gameIds
        -List<Integer> playerCounts
    }

    class GameCreatedUpdate implements Update {
        -String gameId
    }
}

' MESSAGES RELATIONSHIPS
Request <|-- JoinGameRequest
Request <|-- SetupGameRequest
Request <|-- ChooseTotemRequest
Request <|-- PlaceTotemRequest
Request <|-- PickCardRequest
Request <|-- ListGamesRequest
Request <|-- CreateGameRequest
Request <|-- PongResponse

Update <|-- PlayerJoinedUpdate
Update <|-- PlayerDisconnectedUpdate
Update <|-- PlayerReconnectedUpdate
Update <|-- TotemColorUpdate
Update <|-- TotemPlacedUpdate
Update <|-- CardPickedUpdate
Update <|-- TurnChangedUpdate
Update <|-- StateChangedUpdate
Update <|-- EndGameUpdate
Update <|-- ErrorMessageUpdate
Update <|-- PingRequest
Update <|-- GameListUpdate
Update <|-- GameCreatedUpdate

' ============================================================
' CROSS-PACKAGE
' ============================================================

Controller ..> Game
Game -- IGameObserver

@enduml